      "id": "6acefee6-75a9-459d-bfe8-d37c8b3535b0",
      "name": "Confidence check"
    },
    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      answer: \"HiveSpace offers daily passes and hot desks.\",\n      confidence: 0.8\n    }\n  }\n];"
      },
