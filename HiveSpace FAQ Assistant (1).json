        "jsonBody": "{\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"You are a HiveSpace FAQ assistant. Answer the customer's question using only the provided FAQ data. Return JSON containing answer and confidence.\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\"\n  }\n}\n\n\n",
        "options": {}
      },
