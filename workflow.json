      "parameters": {
        "jsCode": "const response = $input.first().json;\n\nconst customerQuestion = $('Code in JavaScript').first().json.customer_question;\n\ntry {\n  const rawText = response.candidates[0].content.parts[0].text;\n\n  const parsedData = JSON.parse(rawText);\n\n  return [{\n    json: {\n      answer: parsedData.answer,\n      confidence: Number(parsedData.confidence),\n      customer_question: customerQuestion,\n      status: \"success\"\n    }\n  }];\n\n} catch (error) {\n  return [{\n    json: {\n      answer: \"I cannot answer that.\",\n      confidence: 0,\n      customer_question: customerQuestion,\n      status: \"error\",\n      error_message: error.message\n    }\n  }];\n}"
      },
