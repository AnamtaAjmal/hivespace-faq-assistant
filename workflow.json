        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "\n{\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"You are HiveSpace FAQ Assistant. Customer question: {{ $json.customer_question }} FAQ data: {{ JSON.stringify($json.faq_data) }} Read all FAQ questions carefully. If the customer question matches an FAQ exactly or has the same meaning, return its answer from the FAQ data. Never say information is unavailable when a relevant answer exists. If no relevant FAQ exists, answer I don't know. Return only valid JSON with exactly two fields: answer and confidence. Exact match confidence: 0.95. Similar match confidence: 0.85. No match confidence: 0.2.\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\",\n    \"temperature\": 0.1\n  }\n}\n\n\n",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1104,
        0
      ],
      "id": "1bbdc296-7185-47b1-a063-a6bbfd1a4367",
      "name": "HTTP Request",
      "retryOnFail": false,
      "executeOnce": true,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all();\n\nconst faqData = rows.map(item => ({\n  question: item.json.question,\n  answer: item.json.answer\n}));\n\nconst customerQuestion = $('Edit Fields').first().json.customer.question;\n\n// Normalize customer question\nconst normalize = (text) => {\n  return String(text)\n    .toLowerCase()\n    .trim()\n    .replace(/[?!.,]/g, \"\")\n    .replace(/\\s+/g, \" \");\n};\n\nconst searchQuestion = normalize(customerQuestion);\n\n// Find exact matching FAQ\nconst matchedFaq = faqData.find(faq =>\n  normalize(faq.question) === searchQuestion\n);\n\nreturn [{\n  json: {\n    customer_question: customerQuestion,\n    faq_data: faqData,\n    exact_match: Boolean(matchedFaq),\n    matched_answer: matchedFaq ? matchedFaq.answer : \"\",\n    confidence: matchedFaq ? 0.95 : 0.2\n  }\n}];\n\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        0
      ],
      "id": "48ea4697-8754-4d47-ab3e-3c38f207d8eb",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const answer = $json.answer;\nconst confidence = Number($json.confidence);\nconst customerQuestion = $json.customer_question;\n\nif (confidence < 0.7) {\n  return [{\n    json: {\n      answer: \"I don't know\",\n      confidence: confidence,\n      customer_question: customerQuestion\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    answer: answer,\n    confidence: confidence,\n    customer_question: customerQuestion\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        -320
      ],
      "id": "6acefee6-75a9-459d-bfe8-d37c8b3535b0",
      "name": "Confidence check"
    },
    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      answer: \"HiveSpace offers daily passes and hot desks.\",\n      confidence: 0.2\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
