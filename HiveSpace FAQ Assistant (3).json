      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all();\n\nconst faqData = rows.map(item => ({\n  question: item.json.question,\n  answer: item.json.answer\n}));\n\nconst customerQuestion = $('Edit Fields').first().json.customer.question;\n\nreturn [{\n  json: {\n    customer_question: customerQuestion,\n    faq_data: faqData\n  }\n}];\n\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        0
      ],
      "id": "48ea4697-8754-4d47-ab3e-3c38f207d8eb",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const answer = $json.answer;\nconst confidence = $json.confidence;\n\nif (confidence < 0.7) {\n  return [{\n    json: {\n      answer: \"I don't know\",\n      confidence: confidence\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    answer: answer,\n    confidence: confidence\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
