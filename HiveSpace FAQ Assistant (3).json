        "specifyBody": "json",
        "jsonBody": "\n{\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"You are a HiveSpace FAQ assistant. Answer the customer's question using only the provided FAQ data. Customer question: {{ $json.customer_question }} FAQ data: {{ JSON.stringify($json.faq_data) }} Respond ONLY with valid JSON. Do not include markdown, explanations, or text outside the JSON object. Return exactly two fields: answer and confidence. Confidence must be a number between 0 and 1.\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\"\n  }\n}\n\n",
        "options": {}
      },
